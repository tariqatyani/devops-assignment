# Shell scripts run inside Linux VMs/containers: always keep LF line endings,
# even when the repo is cloned on Windows (CRLF would break "#!/usr/bin/env bash").
*.sh        text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
Vagrantfile text eol=lf
Dockerfile  text eol=lf
*.ps1 text eol=crlf
